#!/usr/bin/env python3
"""MCP server that exposes X/Twitter search via Grok API."""

import json
import os
import pathlib
import sys
import urllib.request

# Load .env as fallback so the server works even when XAI_API_KEY
# isn't in the process environment (e.g. fresh VM / Codespace).
_dotfiles_dir = pathlib.Path(__file__).resolve().parent.parent
_env_file = _dotfiles_dir / ".env"
if _env_file.exists():
    for _line in _env_file.read_text().splitlines():
        _line = _line.strip()
        if _line and not _line.startswith("#") and "=" in _line:
            _key, _, _value = _line.partition("=")
            os.environ.setdefault(_key.strip(), _value.strip())

API_KEY = os.environ.get("XAI_API_KEY", "")
if not API_KEY:
    print("warning: XAI_API_KEY is not set (checked env and .env)", file=sys.stderr)
API_URL = "https://api.x.ai/v1/responses"
MODEL = os.environ.get("XAI_MODEL", "grok-4-fast")


def search_x(query: str, max_results: int = 10) -> str:
    """Search X/Twitter content via Grok and return a summary."""
    payload = json.dumps({
        "model": MODEL,
        "tools": [{"type": "x_search"}],
        "input": [
            {
                "role": "system",
                "content": (
                    "You are a research assistant that searches X (Twitter) for relevant posts. "
                    "Return the most relevant and recent posts/discussions. "
                    "For each result include: author handle, post text, date if available, "
                    "and a URL if possible. Format results clearly."
                ),
            },
            {
                "role": "user",
                "content": f"Search X for: {query}\n\nReturn up to {max_results} relevant results.",
            },
        ],
    }).encode("utf-8")

    req = urllib.request.Request(
        API_URL,
        data=payload,
        headers={
            "Authorization": f"Bearer {API_KEY}",
            "Content-Type": "application/json",
        },
        method="POST",
    )

    with urllib.request.urlopen(req, timeout=60) as resp:
        data = json.loads(resp.read().decode("utf-8"))

    # Extract text from the responses API output format
    output = data.get("output", [])
    texts = []
    for item in output:
        if item.get("type") == "message":
            for content in item.get("content", []):
                if content.get("type") == "output_text":
                    texts.append(content["text"])
    return "\n".join(texts) if texts else json.dumps(data)


# --- MCP Protocol (JSON-RPC over stdio) ---

TOOLS = [
    {
        "name": "search_x",
        "description": "Search X (Twitter) for posts, discussions, and content on a topic using Grok.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "query": {
                    "type": "string",
                    "description": "The search query for X/Twitter content",
                },
                "max_results": {
                    "type": "integer",
                    "description": "Maximum number of results to return (default 10)",
                    "default": 10,
                },
            },
            "required": ["query"],
        },
    }
]


def handle_request(req):
    method = req.get("method")
    req_id = req.get("id")

    if method == "initialize":
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "protocolVersion": "2024-11-05",
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "grok-x-search", "version": "1.0.0"},
            },
        }

    if method == "notifications/initialized":
        return None

    if method == "tools/list":
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {"tools": TOOLS},
        }

    if method == "tools/call":
        tool_name = req["params"]["name"]
        args = req["params"].get("arguments", {})

        if tool_name == "search_x":
            try:
                result = search_x(args["query"], args.get("max_results", 10))
                return {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "content": [{"type": "text", "text": result}]
                    },
                }
            except Exception as e:
                return {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "content": [{"type": "text", "text": f"Error: {e}"}],
                        "isError": True,
                    },
                }

    return {
        "jsonrpc": "2.0",
        "id": req_id,
        "error": {"code": -32601, "message": f"Unknown method: {method}"},
    }


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except json.JSONDecodeError:
            continue

        response = handle_request(req)
        if response is not None:
            sys.stdout.write(json.dumps(response) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
